# Copy this file to .env and fill in real values. NEVER commit .env.

# PostgreSQL (Session 4). Local example — in production use the Neon connection string.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/jalan_jalan_ai

# Amazon Bedrock (Session 5) — boto3 reads the API key automatically.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-southeast-2
MODEL_ID=amazon.nova-lite-v1:0

# true = return sample AI text without calling Bedrock (local dev without AWS access).
AI_MOCK_MODE=false

# Amazon Bedrock Knowledge Base (Session 9). Leave empty to use the local knowledge/ folder.
KNOWLEDGE_BASE_ID=
# Optional: override the model ARN used by RetrieveAndGenerate.
KB_MODEL_ARN=

# JWT (Session 8). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Conversation memory (Session 10): number of recent messages sent to the model.
CHAT_HISTORY_LIMIT=20

# CORS (Sessions 6 & 11): comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000
# Optional regex, e.g. ^https://jalan-jalan-ai.*\.vercel\.app$ for Vercel preview URLs.
CORS_ORIGIN_REGEX=
